@baseUrl = http://localhost:3000

### 1) POST /auth/registro
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 2) POST /auth/registro mismo email (409)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana@libreria.test", "password": "Libreria2026" }

### 3) POST /auth/registro password "corta" (400)
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{ "nombre": "Ana", "email": "ana2@libreria.test", "password": "corta" }

### 4) POST /auth/login mail que no existe (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "noexiste@libreria.test", "password": "Libreria2026" }

### 5) POST /auth/login password mal (401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "ana@libreria.test", "password": "Mal" }

### 6) POST /auth/login correcto (200)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "ana@libreria.test", "password": "Libreria2026" }

### Guardamos el token
@token = {{login.response.body.token}}

### 7) GET /auth/yo sin header (401)
GET {{baseUrl}}/api/auth/yo

### 8) GET /auth/yo con token (200)
GET {{baseUrl}}/api/auth/yo
Authorization: Bearer {{token}}

### Login ADMIN (del seed) para probar creación de libros
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "admin@libreria.test", "password": "Admin1234" }

###
@tokenAdmin = {{loginAdmin.response.body.token}}

### 9) POST /api/libros sin header (401)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Libro Fallido",
  "precio": 8500,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "disponible": true,
  "autorId": 1
}

### 10) POST /api/libros con CLIENTE (403)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "titulo": "Libro Fallido 2",
  "precio": 8500,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "disponible": true,
  "autorId": 1
}

### 11) POST /api/libros con ADMIN (201)
POST {{baseUrl}}/api/libros
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "titulo": "Nuevo Libro Admin",
  "precio": 8500,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "disponible": true,
  "autorId": 1
}

### 12) GET /api/libros sin header (200 - es público)

### Listar todos los libros con autor incluido (200)
GET {{baseUrl}}/api/libros

### Listar solo disponibles (200)
GET {{baseUrl}}/api/libros?disponible=true

### Ver detalle de un libro con autor y categorías (200)
GET {{baseUrl}}/api/libros/1

### 404 libro no existe
GET {{baseUrl}}/api/libros/9999

### 400 ID inválido (string en vez de número)
GET {{baseUrl}}/api/libros/abc

### Crear libro correcto (201)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Ficciones",
  "precio": 8500,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "disponible": true,
  "autorId": 1
}

### 400 sin título
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "precio": 5000,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "autorId": 1
}

### 409 autor inexistente (violación de FK P2003)
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Huérfano",
  "precio": 5000,
  "imagen": "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c",
  "autorId": 9999
}

### Listar autores (200)
GET {{baseUrl}}/api/autores

### 409 autor con nombre duplicado (violación @unique P2002)
POST {{baseUrl}}/api/autores
Content-Type: application/json

{
  "nombre": "Julio Cortázar",
  "nacionalidad": "Argentina"
}

### 409 borrar autor con libros asociados (onDelete: Restrict P2003)
DELETE {{baseUrl}}/api/autores/1

### 404 actualizar libro que no existe (P2025)
PUT {{baseUrl}}/api/libros/9999
Content-Type: application/json

{
  "precio": 12000
}